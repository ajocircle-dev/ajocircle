# Which chain the app talks to: mezoTestnet | arc | arcTestnet | anvil
NEXT_PUBLIC_CHAIN=mezoTestnet
# AjoCircle contract address on that chain (fill in after Deployer deploys)
NEXT_PUBLIC_AJO_ADDRESS=
# Block the contract was deployed at (keeps event history queries small)
NEXT_PUBLIC_DEPLOY_BLOCK=0
# Default stablecoin for new circles. Leave empty to use the chain default:
#   mezoTestnet -> MUSD 0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
#   arc / arcTestnet -> USDC 0x3600000000000000000000000000000000000000 (6 decimals)
NEXT_PUBLIC_DEFAULT_TOKEN=
# Optional RPC override
NEXT_PUBLIC_RPC_URL=
